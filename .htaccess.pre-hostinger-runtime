# Block direct web access to sensitive files that should never be served,
# regardless of what accidentally ends up in the deployed directory tree.
# Database dumps, migrations, and archives contain real user PII and must
# never be downloadable by URL.

<FilesMatch "\.(sql|zip|bak|log|env|ini|gz|tar)$">
    Require all denied
</FilesMatch>

# Deny any dotfile except the standard .well-known used by some cert providers.
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

# Block access to version control metadata (full history reconstruction risk).
# <DirectoryMatch> isn't permitted inside .htaccess, so use mod_rewrite instead.
RewriteEngine On
RewriteRule (^|/)\.git(/|$) - [F,L]

# Uploaded content is stored under web-visible folders for image/video
# previews. Never let any script-like extension in those folders reach the
# PHP handler, even if an upstream MIME check is later weakened.
RewriteRule (^|/)uploads/.*\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$ - [F,L,NC]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
</IfModule>

# Session cookie hardening. Every page calls session_start() individually
# (no shared bootstrap), so these are set at the PHP-ini level instead of in
# application code - takes effect before any script runs, for every session
# cookie the app issues. cookie_secure is intentionally NOT forced on here:
# it would silently break login on any deployment that isn't yet served over
# HTTPS. Enable it (session.cookie_secure=1) once HTTPS is confirmed live.
<IfModule mod_php.c>
    php_flag session.cookie_httponly on
    php_value session.cookie_samesite Lax
    php_flag session.cookie_secure on
    php_flag session.use_strict_mode on
</IfModule>
<IfModule mod_php7.c>
    php_flag session.cookie_httponly on
    php_value session.cookie_samesite Lax
    php_flag session.cookie_secure on
    php_flag session.use_strict_mode on
</IfModule>
