# Block direct web access to sensitive files that should never be served,
# regardless of what accidentally ends up in the deployed directory tree.
# Database dumps, migrations, and archives contain real user PII and must
# never be downloadable by URL.

<FilesMatch "\.(sql|zip|bak|log|env|ini|gz|tar)$">
    Require all denied
</FilesMatch>

# Deny any dotfile except the standard .well-known used by some cert providers.
<FilesMatch "^\.(?!well-known)">
    Require all denied
</FilesMatch>

# Block access to version control metadata (full history reconstruction risk).
# <DirectoryMatch> isn't permitted inside .htaccess, so use mod_rewrite instead.
RewriteEngine On
RewriteRule (^|/)\.git(/|$) - [F,L]
RewriteRule ^(?:tests|migrations)(?:/|$) - [R=404,L,NC]

# MaterialPro's bundled HTML files are vendor demonstration screens, not Nuru
# application routes. Returning a controlled 404 prevents the public brand
# navigation (or a guessed URL) from exposing an unrelated admin demo.
RewriteRule ^html/material/.*\.html$ - [R=404,L,NC]

# Friendly, crawlable public routes. Existing .php URLs remain supported.
RewriteRule ^properties/?$ properties.php [L,QSA]
RewriteRule ^property/([0-9]+)/?$ property.php?id=$1 [L,QSA]
RewriteRule ^about/?$ about.php [L,QSA]
RewriteRule ^contact/?$ contact.php [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Clean portal routes, dispatched through the app/Core/Router front
# controller (public/index.php). The old html/material/*.php URLs keep
# working unchanged - these are additive, not replacements.
RewriteRule ^login/?$ public/index.php?__route=login [L,QSA]
RewriteRule ^logout/?$ public/index.php?__route=logout [L,QSA]
RewriteRule ^buyer/?$ public/index.php?__route=buyer [L,QSA]
RewriteRule ^seller/?$ public/index.php?__route=seller [L,QSA]
RewriteRule ^agent/?$ public/index.php?__route=agent [L,QSA]

# Buyer management (formerly html/material/buyers-list.php etc.) - MVC'd
# behind App\Controllers\Admin\BuyerController, old URLs remain supported
# via thin shims left in place at their original html/material/*.php paths.
RewriteRule ^admin/dashboard/?$ public/index.php?__route=admin/dashboard [L,QSA]
RewriteRule ^admin/buyers-list/?$ public/index.php?__route=admin/buyers-list [L,QSA]
RewriteRule ^admin/buyer-admin-form/?$ public/index.php?__route=admin/buyer-admin-form [L,QSA]
RewriteRule ^admin/admin-buyer-processor/?$ public/index.php?__route=admin/admin-buyer-processor [L,QSA]
RewriteRule ^admin/buyers-profile/?$ public/index.php?__route=admin/buyers-profile [L,QSA]
RewriteRule ^admin/approve-buyer/?$ public/index.php?__route=admin/approve-buyer [L,QSA]
RewriteRule ^admin/delete-buyer/?$ public/index.php?__route=admin/delete-buyer [L,QSA]

# Internal staff-facing seller management (formerly html/material/{sellers-list,
# sellerlist_table,sellers_profile,seller_admin_form,seller_admin_processor}.php
# and html/material/config/review_seller_application.php) - MVC'd behind
# App\Controllers\Admin\SellerController, old URLs remain supported via thin
# shims left in place at their original html/material/*.php paths. Not to be
# confused with html/material/seller/ (the separate public application form,
# already served at /seller above).
RewriteRule ^admin/sellers-list/?$ public/index.php?__route=admin/sellers-list [L,QSA]
RewriteRule ^admin/sellers-profile/?$ public/index.php?__route=admin/sellers-profile [L,QSA]
RewriteRule ^admin/seller-admin-form/?$ public/index.php?__route=admin/seller-admin-form [L,QSA]
RewriteRule ^admin/seller-admin-processor/?$ public/index.php?__route=admin/seller-admin-processor [L,QSA]
RewriteRule ^admin/review-seller-application/?$ public/index.php?__route=admin/review-seller-application [L,QSA]

# Internal staff-facing agent management (formerly html/material/{agent_list,
# agenttable_list,agent_admin_form,admin_agent_processor,agent_profile}.php
# and html/material/config/{approve_agent_application,delete_agent,
# update_agent_status}.php) plus the "quick consult" walk-in buyer workflow
# (formerly html/material/{consulting_agent_form,
# admin_consulting_agent_processor,consultant_list}.php) - MVC'd behind
# App\Controllers\Admin\{AgentController,ConsultantController}, old URLs
# remain supported via thin shims left in place at their original
# html/material/*.php paths. agenttable_list.php was always a guarded
# partial with no direct route of its own (see admin/selleragent-table
# above for the same pattern) - it still 404s when requested directly. Not
# to be confused with html/material/agent/ (the separate public
# application form, already served at /agent above).
RewriteRule ^admin/agent-list/?$ public/index.php?__route=admin/agent-list [L,QSA]
RewriteRule ^admin/agenttable-list/?$ public/index.php?__route=admin/agenttable-list [L,QSA]
RewriteRule ^admin/agent-admin-form/?$ public/index.php?__route=admin/agent-admin-form [L,QSA]
RewriteRule ^admin/admin-agent-processor/?$ public/index.php?__route=admin/admin-agent-processor [L,QSA]
RewriteRule ^admin/agent-profile/?$ public/index.php?__route=admin/agent-profile [L,QSA]
RewriteRule ^admin/approve-agent-application/?$ public/index.php?__route=admin/approve-agent-application [L,QSA]
RewriteRule ^admin/delete-agent/?$ public/index.php?__route=admin/delete-agent [L,QSA]
RewriteRule ^admin/update-agent-status/?$ public/index.php?__route=admin/update-agent-status [L,QSA]
RewriteRule ^admin/consulting-agent-form/?$ public/index.php?__route=admin/consulting-agent-form [L,QSA]
RewriteRule ^admin/admin-consulting-agent-processor/?$ public/index.php?__route=admin/admin-consulting-agent-processor [L,QSA]
RewriteRule ^admin/consultant-list/?$ public/index.php?__route=admin/consultant-list [L,QSA]

RewriteRule ^admin/properties-list/?$ public/index.php?__route=admin/properties-list [L,QSA]
RewriteRule ^admin/properties-available/?$ public/index.php?__route=admin/properties-available [L,QSA]
RewriteRule ^admin/properties-sold/?$ public/index.php?__route=admin/properties-sold [L,QSA]
RewriteRule ^admin/property-admin-form/?$ public/index.php?__route=admin/property-admin-form [L,QSA]

# Buyer/seller matching engine (formerly html/material/{match-results,
# match-table,match-table1,match_list,match_property,matched_sellers,
# agentsellers_matched,selleragent_table}.php) - MVC'd behind
# App\Controllers\Admin\MatchingController, old URLs remain supported via
# thin shims left in place at their original html/material/*.php paths.
RewriteRule ^admin/match-results/?$ public/index.php?__route=admin/match-results [L,QSA]
RewriteRule ^admin/match-table/?$ public/index.php?__route=admin/match-table [L,QSA]
RewriteRule ^admin/match-table1/?$ public/index.php?__route=admin/match-table1 [L,QSA]
RewriteRule ^admin/match-list/?$ public/index.php?__route=admin/match-list [L,QSA]
RewriteRule ^admin/match-property/?$ public/index.php?__route=admin/match-property [L,QSA]
RewriteRule ^admin/matched-sellers/?$ public/index.php?__route=admin/matched-sellers [L,QSA]
RewriteRule ^admin/agentsellers-matched/?$ public/index.php?__route=admin/agentsellers-matched [L,QSA]
RewriteRule ^admin/selleragent-table/?$ public/index.php?__route=admin/selleragent-table [L,QSA]

# Reports, analytics, exports, settings, backup/restore, activity log, user
# management, document streaming, and the public-inquiries review list
# (formerly html/material/{reports-dashboard,reports-sales,reports-property,
# reports-agent,reports-custom,analytics,exports,settings-general,
# settings-email,settings-database,backup-restore,activity-log,
# user-management,view_document,public-inquiries}.php) - MVC'd behind
# App\Controllers\Admin\{ReportController,SettingsController,
# DocumentController,InquiryController}, old URLs remain supported via thin
# shims left in place at their original html/material/*.php paths.
RewriteRule ^admin/reports-dashboard/?$ public/index.php?__route=admin/reports-dashboard [L,QSA]
RewriteRule ^admin/reports-sales/?$ public/index.php?__route=admin/reports-sales [L,QSA]
RewriteRule ^admin/reports-property/?$ public/index.php?__route=admin/reports-property [L,QSA]
RewriteRule ^admin/reports-agent/?$ public/index.php?__route=admin/reports-agent [L,QSA]
RewriteRule ^admin/reports-custom/?$ public/index.php?__route=admin/reports-custom [L,QSA]
RewriteRule ^admin/analytics/?$ public/index.php?__route=admin/analytics [L,QSA]
RewriteRule ^admin/exports/?$ public/index.php?__route=admin/exports [L,QSA]
RewriteRule ^admin/settings-general/?$ public/index.php?__route=admin/settings-general [L,QSA]
RewriteRule ^admin/settings-email/?$ public/index.php?__route=admin/settings-email [L,QSA]
RewriteRule ^admin/settings-database/?$ public/index.php?__route=admin/settings-database [L,QSA]
RewriteRule ^admin/backup-restore/?$ public/index.php?__route=admin/backup-restore [L,QSA]
RewriteRule ^admin/activity-log/?$ public/index.php?__route=admin/activity-log [L,QSA]
RewriteRule ^admin/activity-log-export/?$ public/index.php?__route=admin/activity-log-export [L,QSA]
RewriteRule ^admin/user-management/?$ public/index.php?__route=admin/user-management [L,QSA]
RewriteRule ^admin/view-document/?$ public/index.php?__route=admin/view-document [L,QSA]
RewriteRule ^admin/public-inquiries/?$ public/index.php?__route=admin/public-inquiries [L,QSA]

# Agent task allocation lists/detail (formerly html/material/{tasks-pending,
# tasks-in-progress,tasks-completed,tasks-cancelled,agent-tasks-pending,
# agent_tasks-in-progress,task_view}.php) plus their JSON mutation endpoints
# (html/material/config/{assign_agent_task,reassign_task,
# update_task_progress,agent_update_task_status}.php), and the property
# checklist/stage system (html/material/{checklist,items,add_items,stages,
# add_stages}.php and html/material/config/{save_stage,get_stages,
# save-checklist-item,save_checklist_item}.php) - MVC'd behind
# App\Controllers\Admin\TaskController, old URLs remain supported via thin
# shims left in place at their original html/material/*.php paths.
# config/save-checklist-item.php (agent checklist toggle) and
# config/save_checklist_item.php (admin checklist item definition) are two
# distinct legacy endpoints that would collide under this file's usual
# underscore-to-hyphen naming rule, so the latter is exposed as
# admin/add-checklist-item instead of a second admin/save-checklist-item.
RewriteRule ^admin/tasks-pending/?$ public/index.php?__route=admin/tasks-pending [L,QSA]
RewriteRule ^admin/tasks-in-progress/?$ public/index.php?__route=admin/tasks-in-progress [L,QSA]
RewriteRule ^admin/tasks-completed/?$ public/index.php?__route=admin/tasks-completed [L,QSA]
RewriteRule ^admin/tasks-cancelled/?$ public/index.php?__route=admin/tasks-cancelled [L,QSA]
RewriteRule ^admin/agent-tasks-pending/?$ public/index.php?__route=admin/agent-tasks-pending [L,QSA]
RewriteRule ^admin/agent-tasks-in-progress/?$ public/index.php?__route=admin/agent-tasks-in-progress [L,QSA]
RewriteRule ^admin/task-view/?$ public/index.php?__route=admin/task-view [L,QSA]
RewriteRule ^admin/assign-agent-task/?$ public/index.php?__route=admin/assign-agent-task [L,QSA]
RewriteRule ^admin/reassign-task/?$ public/index.php?__route=admin/reassign-task [L,QSA]
RewriteRule ^admin/update-task-progress/?$ public/index.php?__route=admin/update-task-progress [L,QSA]
RewriteRule ^admin/agent-update-task-status/?$ public/index.php?__route=admin/agent-update-task-status [L,QSA]
RewriteRule ^admin/checklist/?$ public/index.php?__route=admin/checklist [L,QSA]
RewriteRule ^admin/items/?$ public/index.php?__route=admin/items [L,QSA]
RewriteRule ^admin/add-items/?$ public/index.php?__route=admin/add-items [L,QSA]
RewriteRule ^admin/stages/?$ public/index.php?__route=admin/stages [L,QSA]
RewriteRule ^admin/add-stages/?$ public/index.php?__route=admin/add-stages [L,QSA]
RewriteRule ^admin/save-stage/?$ public/index.php?__route=admin/save-stage [L,QSA]
RewriteRule ^admin/get-stages/?$ public/index.php?__route=admin/get-stages [L,QSA]
RewriteRule ^admin/save-checklist-item/?$ public/index.php?__route=admin/save-checklist-item [L,QSA]
RewriteRule ^admin/add-checklist-item/?$ public/index.php?__route=admin/add-checklist-item [L,QSA]

# Uploaded content is stored under web-visible folders for image/video
# previews. Never let any script-like extension in those folders reach the
# PHP handler, even if an upstream MIME check is later weakened.
RewriteRule (^|/)uploads/.*\.(php[0-9]?|phtml|phar|cgi|pl|py|sh)$ - [F,L,NC]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Content-Security-Policy "base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
    # Browsers ignore HSTS received over plain HTTP, so this can be emitted
    # unconditionally and still works when a CDN terminates TLS upstream.
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

Options -Indexes

# Session cookie hardening. Every page calls session_start() individually
# (no shared bootstrap), so these are set at the PHP-ini level instead of in
# application code - takes effect before any script runs, for every session
# cookie the app issues. Production PHP-FPM deployments should set
# session.cookie_secure=1 in their non-public runtime configuration; local
# loopback HTTP remains usable with the development value below.
<IfModule mod_php.c>
    php_flag session.cookie_httponly on
    php_value session.cookie_samesite Lax
    php_flag session.cookie_secure off
    php_flag session.use_strict_mode on
</IfModule>
<IfModule mod_php7.c>
    php_flag session.cookie_httponly on
    php_value session.cookie_samesite Lax
    php_flag session.cookie_secure off
    php_flag session.use_strict_mode on
</IfModule>
